-- Power BI measures for the synthetic property portfolio model
-- Format occupancy and collection rate measures as percentages in Power BI.

Gross Rent =
SUM ( fact_property_monthly[gross_rent] )

Collected Rent =
SUM ( fact_property_monthly[collected_rent] )

Rent Collection Rate =
DIVIDE ( [Collected Rent], [Gross Rent] )

Average Monthly Occupancy % =
AVERAGE ( fact_property_monthly[occupancy_pct] )

Property Count =
DISTINCTCOUNT ( dim_property[property_id] )

-- Average gross rent per property-month square foot in the current filter context.
Gross Rent per Sq Ft =
DIVIDE (
    [Gross Rent],
    SUMX (
        fact_property_monthly,
        RELATED ( dim_property[area_sqft] )
    )
)

-- Annualized run rate based on the average monthly gross rent in the current context.
Annualized Gross Rent Run Rate =
VAR SelectedMonths =
    DISTINCTCOUNT ( fact_property_monthly[month] )
RETURN
    DIVIDE ( [Gross Rent], SelectedMonths ) * 12
